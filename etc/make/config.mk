CMAKE_BIN := $(CMAKE_PATH)/cmake
CCMAKE_BIN := $(CMAKE_PATH)/ccmake
GENERATOR_NAME := Ninja
GENERATOR_PATH := ninja
CMAKE_LOG_LEVEL := NOTICE
